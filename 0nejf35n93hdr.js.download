        isResolved
        isOutdated
        subjectType
        diffSide
        startDiffSide
        line
        startLine
        commentsComplete
        comments {
          id
          body
          createdAt
          url
          truncated
          author {
            login
            avatarUrl
          }
        }
      }
    }
    ... on UserError {
      message
    }
    ... on UnauthorizedError {
      message
    }
    ... on NotFoundError {
      message
    }
