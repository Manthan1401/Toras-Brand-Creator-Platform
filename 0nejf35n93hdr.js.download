    ${r}`,c=t.gql`
    query SourceControlPullRequestPage($input: GitHubPullRequestInput!, $after: String, $withCommits: Boolean! = true) {
  githubPullRequest(input: $input) {
    __typename
    ... on Error {
      message
    }
    ... on GitHubPullRequest {
      ...SourceControlPullRequestOverview
      files(count: 100, after: $after) {
        __typename
        ... on Error {
          message
        }
        ... on GitHubPullRequestFileConnection {
          baseSha
          headSha
          totalCount
          isTruncated
          pageInfo {
            hasNextPage
            nextCursor
          }
          items {
            ...SourceControlPullRequestFile
          }
        }
      }
      commits(count: 100) @include(if: $withCommits) {
        __typename
        ... on Error {
          message
        }
        ... on GitHubPullRequestCommitConnection {
          baseSha
          headSha
          totalCount
          isTruncated
          pageInfo {
            hasNextPage
            nextCursor
          }
          items {
            ...SourceControlPullRequestCommit
          }
        }
      }
    }
  }
}
