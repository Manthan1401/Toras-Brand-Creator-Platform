ription"},ASHBY:{description:"Access job postings, candidates, and applications from your Ashby ATS",descriptionIntlId:"connectors.ashbyDescription"},ASANA:{description:"Read tasks and project data from Asana workspaces",descriptionIntlId:"connectors.asanaDescription"},SPROUTSOCIAL:{description:"Manage social media profiles, posts, messages, and cases from Sprout Social",descriptionIntlId:"connectors.sproutsocialDescription"},BITBUCKET:{description:"Access Bitbucket repositories, users, and organizations from Replit",descriptionIntlId:"connectors.bitbucketDescription"},BITBUCKET_SOURCE_CONTROL:{description:"Sync code to Bitbucket repositories from your Replit apps",descriptionIntlId:"connectors.bitbucketSourceControlDescription",longDescription:"Bitbucket is Atlassian's Git hosting service with built-in CI/CD through Bitbucket Pipelines. This integration lets you access repositories and branches, create and review pull requests, trigger pipelines, and read workspace data. Use it to automate code review workflows, sync repository metadata, or build developer experience tools.",longDescriptionIntlId:"connectors.bitbucketSourceControlLongDescription"},GITHUB_SOURCE_CONTROL:{description:"Sync code to GitHub repositories from your Replit apps",descriptionIntlId:"connectors.githubSourceControlDescription",longDescription:"GitHub is the world's largest platform for hosting and collaborating on code. This integration lets you read and write repositories, manage issues and pull requests, trigger and monitor GitHub Actions, and access user and organization data. It's a foundation for developer tools, CI pipelines, and code review automations.",longDescriptionIntlId:"connectors.githubSourceControlLongDescription"},GITLAB_SOURCE_CONTROL:{description:"Sync code to GitLab projects from your Replit apps",descriptionIntlId:"connectors.gitlabSourceControlDescription",longDescription:"GitLab is a complete DevOps platform providing source control, CI/CD, and project management in one tool. This integration lets you read and write repositories, manage merge requests and issues, trigger pipelines, and access group and project data. Use it to build developer tooling, automate code review workflows, or integrate GitLab data into your CI pipelines.",longDescriptionIntlId:"connectors.gitlabSourceControlLongDescription"},DATABRICKS_M2M:{description:"Execute SQL queries and manage data workflows in Databricks using a service account",descriptionIntlId:"connectors.databricksM2mDescription"},BIGQUERY:{description:"Execute SQL queries on Google BigQuery datasets from your Replit apps",descriptionIntlId:"connectors.bigqueryDescription"},BIGQUERY_SA:{description:"Query BigQuery as a shared service account so cost attributes to the app",descriptionIntlId:"connectors.bigquerySaDescription"},BOX:{description:"Access Box files and folders from Replit",descriptionIntlId:"connectors.boxDescription"},CALENDLY:{description:"View Calendly events and event types",descriptionIntlId:"connectors.calendlyDescription"},CONFLUENCE:{description:"Read users and groups, create and edit content in Confluence spaces",descriptionIntlId:"connectors.confluenceDescription"},CLICKUP:{description:"Access tasks, projects, and workflows in ClickUp",descriptionIntlId:"connectors.clickupDescription"},DATABRICKS:{description:"Execute SQL queries and manage data workflows in Databricks",descriptionIntlId:"connectors.databricksDescription"},DISCORD:{description:"Access Discord guild information and user profiles",descriptionIntlId:"connectors.discordDescription"},DROPBOX:{description:"Access Dropbox files, content, and metadata",descriptionIntlId:"connectors.dropboxDescription"},ELEVENLABS:{description:"AI voice generation and text-to-speech",descriptionIntlId:"connectors.elevenlabsDescription"},HEX:{description:"Run data notebooks, manage projects, and trigger Hex project runs via API",descriptionIntlId:"connectors.hexDescription"},OPENAI:{description:"Access your own OpenAI API key instead of default Replit-managed AI integrations",descriptionIntlId:"connectors.openaiDescription"},FACEBOOK:{description:"View Facebook profiles, posts, photos, and manage pages",descriptionIntlId:"connectors.facebookDescription"},GITHUB:{description:"Access GitHub repositories, users, and organizations from your Replit apps",descriptionIntlId:"connectors.githubDescription"},GOOGLE_CALENDAR:{description:"Read and write Google Calendar events and settings",descriptionIntlId:"connectors.googleCalendarDescription"},GOOGLE_DOCS:{description:"Create, read, and edit Google Docs",descriptionIntlId:"connectors.googleDocsDescription"},GOOGLE_DRIVE:{description:"Access and manage Google Drive files and folders",descriptionIntlId:"connectors.googleDriveDescription"},GOOGLE_MAIL:{description:"Send, receive, and manage Gmail messages",descriptionIntlId:"connectors.googleMailDescription"},GOOGLE_SHEET:{description:"Read and write data in Google Sheets",descriptionIntlId:"connectors.googleSheetDescription"},GOOGLE_SLIDES:{description:"Create, read, and edit Google Slides presentations",descriptionIntlId:"connectors.googleSlidesDescription"},HUBSPOT:{description:"Access HubSpot CRM objects, contacts, and deals from Replit",descriptionIntlId:"connectors.hubspotDescription"},INSTAGRAM:{description:"Manage Instagram business content, messages, and insights",descriptionIntlId:"connectors.instagramDescription"},JIRA:{description:"View users and manage Jira work items and issues",descriptionIntlId:"connectors.jiraDescription"},LINEAR:{description:"Create and manage Linear issues, comments, and schedules",descriptionIntlId:"connectors.linearDescription"},MONDAY:{description:"Access Monday.com boards and user information",descriptionIntlId:"connectors.mondayDescription"},MOBILE_MAPS:{description:"Access mobile maps and locations from Replit",descriptionIntlId:"connectors.mobileMapsDescription"},NOTION:{description:"Read and write to Notion workspaces and pages",descriptionIntlId:"connectors.not